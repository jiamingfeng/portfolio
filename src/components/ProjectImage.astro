---
// Static image card (e.g. official key art). Looks for <slug>/<src>.jpg under
// public/assets/<slug>/. Matches the 16:9 framing of the video components.
import { withBase } from '../utils/url';

interface Props {
  slug: string;
  src: string;
  poster?: string; // unused for images; kept for media-type symmetry
  title?: string;
  scale?: number; // 0–1 fraction of the column width; see MediaItem
}
const { slug, src, title, scale = 1 } = Astro.props;
const dir = withBase(`assets/${slug}/`);
// scripts/optimize-images.sh writes a .webp sibling for every still, so serve
// that and keep the .jpg as the <img> fallback — <picture> costs nothing.
const url = `${dir}${src}.jpg`;
const webp = `${dir}${src}.webp`;
---

<figure class="still" style={scale < 1 ? `max-width:${scale * 100}%` : undefined}>
  <picture>
    <source srcset={webp} type="image/webp" />
    <img class="still-img" src={url} alt={title} loading="lazy" width="1280" height="720" />
  </picture>
  {title && <figcaption class="still-caption">{title}</figcaption>}
</figure>

<style>
  .still {
    margin: 0;
  }
  .still-img {
    width: 100%;
    /* The width/height attributes (for layout-shift reservation) would otherwise
       pin the height at 720px and let object-fit zoom-crop at narrower widths. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .still-caption {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dim);
  }
</style>
